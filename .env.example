# Copy to .env and adjust. .env is git-ignored — never commit real secrets.

POSTGRES_USER=braindump
POSTGRES_PASSWORD=braindump
POSTGRES_DB=braindump
DB_HOST_PORT=5433

# Used by the API when run outside Docker (uv run ...)
DATABASE_URL=postgresql+psycopg://braindump:braindump@localhost:5433/braindump
DATA_DIR=./data
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO

# Local AI via Ollama (free, nothing leaves your machine). Set both to "none" to disable.
#   brew install ollama && brew services start ollama
#   ollama pull embeddinggemma && ollama pull qwen3.5:9b
EMBEDDING_PROVIDER=ollama
CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma
CHAT_MODEL=qwen3.5:9b
